<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cyanrocks.ai.dao.mapper.AiDrawRecordMapper">
    <resultMap id="AiDrawRecord" type="com.cyanrocks.ai.dao.entity.AiDrawRecord">
        <id property="id" column="id"/>
        <result property="path" column="path"/>
        <result property="type" column="type"/>
        <result property="createAt" column="create_at"/>
    </resultMap>
    <select id="getRecordPage" resultMap="AiDrawRecord">
        select * from ai_draw_record
        <if test="search != '' and search != null">
            where ${search}
        </if>
        order by
        <if test="sort != '' and sort != null">
            ${sort},
        </if>
        id desc
    </select>

</mapper>
